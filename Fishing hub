    }, Track)
    corner(Fill, 10)

    local Knob = new("Frame", {
        Name = "Knob",
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0.4, -8, 0.5, -8),
    }, Track)
    corner(Knob, 8)

    local ValueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(410, 0),
        Size = UDim2.fromOffset(28, 34),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = WHITE,
        Text = "50",
    }, SliderFrame)

    local function setSpeedValue(v)
        v = math.clamp(math.floor(v + 0.5), 16, 100)
        Config.SpeedValue = v
        local rel = (v - 16) / 84
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        Knob.Position = UDim2.new(rel, -8, 0.5, -8)
        ValueLabel.Text = tostring(v)
    end
    setSpeedValue(Config.SpeedValue)

    local function setSliderFromX(x)
        local w = Track.AbsoluteSize.X
        if w <= 0 then return end
        local rel = math.clamp((x - Track.AbsolutePosition.X) / w, 0, 1)
        setSpeedValue(16 + rel * 84)
    end

    do
        local sliding = false
        track(SliderFrame.InputBegan:Connect(function(input)
            if isPress(input) then
                sliding = true
                MiscPage.ScrollingEnabled = false
                setSliderFromX(input.Position.X)
            end
        end))
        track(UserInputService.InputChanged:Connect(function(input)
            if sliding and isMove(input) then
                setSliderFromX(input.Position.X)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if sliding and isPress(input) then
                sliding = false
                MiscPage.ScrollingEnabled = true
            end
        end))
    end

    createToggle(MiscPage, "Speed Boost", "SpeedBoost", 1, function(on)
        SliderFrame.Visible = on
    end)
    createToggle(MiscPage, "Auto Farm Level", "AutoFarmLevel", 3)
    createToggle(MiscPage, "ESP (Highlight Enemies)", "ESP", 4)

    ---------------------------------------------------------------------
    -- Minimize / Close
    ---------------------------------------------------------------------
    local minimized = false
    track(MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        closeAll()
        if minimized then
            Body.Visible = false
            MinBtn.Text = "+"
            TweenService:Create(Main, TweenInfo.new(0.15), {
                Size = UDim2.fromOffset(480, 35),
            }):Play()
        else
            Body.Visible = true
            MinBtn.Text = "—"
            TweenService:Create(Main, TweenInfo.new(0.15), {
                Size = UDim2.fromOffset(480, 380),
            }):Play()
        end
    end))

    ---------------------------------------------------------------------
    -- Public API
    ---------------------------------------------------------------------
    local API
    local destroyed = false

    local function SetDropdownItems(name, items, callback)
        local d = Dropdowns[name]
        if d then d.SetItems(items, callback) end
    end

    local function SetToggle(name, value)
        local t = ToggleStates[name]
        if t then t.Set(value) end
    end

    local function Destroy()
        if destroyed then return end
        destroyed = true
        for _, c in ipairs(Connections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(Connections)
        pcall(function() Gui:Destroy() end)
        for k, v in pairs(Config) do
            if type(v) == "boolean" then Config[k] = false end
        end
        if _G.BananaCatUI == API then _G.BananaCatUI = nil end
    end

    track(CloseBtn.MouseButton1Click:Connect(function()
        if _G.BananaCatCore and _G.BananaCatCore.StopAll then
            pcall(_G.BananaCatCore.StopAll)
        end
        Destroy()
    end))

    API = {
        Config = Config,
        Notify = Notify,
        SetDropdownItems = SetDropdownItems,
        SetToggle = SetToggle,
        Destroy = Destroy,
        ToggleStates = ToggleStates,
        Dropdowns = Dropdowns,
        Gui = Gui,
    }
    _G.BananaCatUI = API

    selectTab("Fishing")
end

-- PART 2: Core
do
    if _G.BananaCatCore and _G.BananaCatCore.StopAll then
        pcall(_G.BananaCatCore.StopAll)
    end

    local t = 0
    while not _G.BananaCatUI and t < 10 do
        task.wait(0.1)
        t += 0.1
    end
    if not _G.BananaCatUI then
        warn("[Core] UI not found")
        return
    end

    local UI = _G.BananaCatUI
    local Config = UI.Config
    local Notify = UI.Notify
    local SetDropdownItems = UI.SetDropdownItems
    local OwnGui = UI.Gui

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local VirtualUser = game:GetService("VirtualUser")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local Running = true
    local Connections = {}

    ---------------------------------------------------------------------
    -- Helpers
    ---------------------------------------------------------------------
    local function notify(msg, on)
        if type(Notify) == "function" then pcall(Notify, msg, on) end
    end

    local function getChar()
        return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    end
    local function getHum()
        local ok, r = pcall(function()
            return getChar():FindFirstChildOfClass("Humanoid")
        end)
        return ok and r or nil
    end
    local function getRoot()
        local ok, r = pcall(function()
            return getChar():FindFirstChild("HumanoidRootPart")
        end)
        return ok and r or nil
    end
    local function isAlive()
        local h = getHum()
        return h ~= nil and h.Health > 0
    end

    local function getBackpack()
        return LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack", 5)
    end

    local function findTool(name)
        if not name then return nil end
        local ok, tool = pcall(function()
            local bp = getBackpack()
            local found = bp and bp:FindFirstChild(name)
            if found then return found end
            local char = LocalPlayer.Character
            return char and char:FindFirstChild(name)
        end)
        return ok and tool or nil
    end

    local function playerGui()
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end

    -- Scans every ScreenGui except our own hub. fn(inst) -> true stops the scan.
    local function scanPlayerGui(fn)
        local pg = playerGui()
        if not pg then return nil end
        for _, g in ipairs(pg:GetChildren()) do
            if g ~= OwnGui then
                if fn(g) then return g end
                for _, d in ipairs(g:GetDescendants()) do
                    if fn(d) then return d end
                end
            end
        end
        return nil
    end

    ---------------------------------------------------------------------
    -- Remote cache
    ---------------------------------------------------------------------
    local RemoteCache = {}

    local function isRemote(r)
        return r ~= nil and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction"))
    end

    local function searchShallow(root, names)
        for _, n in ipairs(names) do
            local r = root:FindFirstChild(n)
            if isRemote(r) then return r end
        end
        for _, n in ipairs(names) do
            for _, child in ipairs(root:GetChildren()) do
                local r = child:FindFirstChild(n)
                if isRemote(r) then return r end
            end
        end
        return nil
    end

    local function findRemote(names)
        local key = table.concat(names, "|")
        local entry = RemoteCache[key]
        if entry then
            if entry.remote and entry.remote.Parent then
                return entry.remote
            end
            if not entry.remote and os.clock() < entry.retryAt then
                return nil
            end
        end

        local found = nil
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                found = searchShallow(remotes, names)
            end
            if not found then
                -- ONE recursive fallback; result (incl. nil) is cached below
                for _, n in ipairs(names) do
                    local r = ReplicatedStorage:FindFirstChild(n, true)
                    if isRemote(r) then
                        found = r
                        break
                    end
                end
            end
        end)

        if found then
            RemoteCache[key] = { remote = found }
        else
            RemoteCache[key] = { remote = nil, retryAt = os.clock() + 60 }
        end
        return found
    end

    local function fire(remote, ...)
        if not remote then return false end
        local args = { ... }
        local ok = pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(table.unpack(args))
            else
                remote:InvokeServer(table.unpack(args))
            end
        end)
        return ok
    end

    -- Cached workspace lookups (NPCs / spawn), with a 60s miss cooldown
    local npcCache = {}
    local function findNPC(names)
        local key = table.concat(names, "|")
        local c = npcCache[key]
        if c then
            if c.inst and c.inst.Parent then return c.inst end
            if not c.inst and os.clock() < c.retryAt then return nil end
        end
        local found = nil
        pcall(function()
            for _, n in ipairs(names) do
                local r = workspace:FindFirstChild(n, true)
                if r then
                    found = r
                    break
                end
            end
        end)
        npcCache[key] = { inst = found, retryAt = os.clock() + 60 }
        return found
    end

    local spawnCache = nil
    local spawnRetry = 0
    local function findSpawn()
        if spawnCache and spawnCache.Parent then return spawnCache end
        if os.clock() < spawnRetry then return nil end
        pcall(function()
            spawnCache = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
        end)
        if not spawnCache then spawnRetry = os.clock() + 60 end
        return spawnCache
    end

    ---------------------------------------------------------------------
    -- Movement / input helpers
    ---------------------------------------------------------------------
    local function tweenTo(cf, duration)
        local root = getRoot()
        if not root then return end
        pcall(function()
            local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = cf })
            tw:Play()
            -- caller is responsible for timing waits
        end)
    end

    local function screenCenter()
        local cam = workspace.CurrentCamera
        if cam then
            local vp = cam.ViewportSize
            return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        end
        return UserInputService:GetMouseLocation()
    end

    local function clickAt(pos)
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(pos)
            task.wait(0.05)
            VirtualUser:Button1Up(pos)
        end)
    end

    local function activatePrompt(prompt)
        if type(fireproximityprompt) == "function" then
            local ok = pcall(fireproximityprompt, prompt)
            if ok then return true end
        end
        local pos = nil
        pcall(function()
            local part = prompt.Parent
            local cam = workspace.CurrentCamera
            if part and part:IsA("BasePart") and cam then
                local v, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then pos = Vector2.new(v.X, v.Y) end
            end
        end)
        clickAt(pos or screenCenter())
        return true
    end

    local function activateButton(btn)
        if type(firesignal) == "function" then
            local ok = pcall(function() firesignal(btn.MouseButton1Click) end)
            if ok then return true end
        end
        local pos = nil
        pcall(function()
            pos = btn.AbsolutePosition + (btn.AbsoluteSize * 0.5)
        end)
        clickAt(pos or screenCenter())
        return true
    end

