    ---------------------------------------------------------------------
    -- Notifications
    ---------------------------------------------------------------------
    local ToastHolder = new("Frame", {
        Name = "Toasts",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 10),
        Size = UDim2.fromOffset(220, 300),
        ZIndex = 100,
    }, Gui)
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, ToastHolder)

    local toastCount = 0
    local function Notify(message, isOn)
        pcall(function()
            toastCount += 1
            local toast = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                BackgroundTransparency = 0.2,
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(220, 40),
                LayoutOrder = -toastCount,
            }, ToastHolder)
            corner(toast, 6)
            local strip = new("Frame", {
                BackgroundColor3 = isOn and GREEN or RED,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 4, 1, 0),
            }, toast)
            corner(strip, 2)
            local lbl = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -16, 1, 0),
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = WHITE,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Text = tostring(message),
            }, toast)
            task.delay(2, function()
                pcall(function()
                    if not toast.Parent then return end
                    local info = TweenInfo.new(0.3)
                    TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
                    TweenService:Create(strip, info, { BackgroundTransparency = 1 }):Play()
                    TweenService:Create(lbl, info, { TextTransparency = 1 }):Play()
                    task.delay(0.35, function()
                        pcall(function() toast:Destroy() end)
                    end)
                end)
            end)
        end)
    end

    ---------------------------------------------------------------------
