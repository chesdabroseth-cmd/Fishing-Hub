    ---------------------------------------------------------------------
    -- STEP 2: Speed Boost
    ---------------------------------------------------------------------
    local OriginalWalkSpeed = 16

    local function captureOriginalSpeed()
        local hum = getHum()
        if hum and not Config.SpeedBoost then
            OriginalWalkSpeed = hum.WalkSpeed
        end
    end

    task.spawn(function()
        pcall(captureOriginalSpeed)
    end)

    local function applySpeed()
        local hum = getHum()
        if hum and hum.WalkSpeed ~= Config.SpeedValue then
            hum.WalkSpeed = Config.SpeedValue
        end
    end

    table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if not Running then return end
        if Config.SpeedBoost then
            pcall(applySpeed)
        else
            pcall(captureOriginalSpeed)
        end
    end))

    task.spawn(function()
        local wasOn = false
        while Running and task.wait(0.2) do
            if Config.SpeedBoost then
                wasOn = true
                pcall(applySpeed)
            elseif wasOn then
                wasOn = false
                local hum = getHum()
                if hum then pcall(function() hum.WalkSpeed = OriginalWalkSpeed end) end
            end
        end
    end)

    ---------------------------------------------------------------------
    -- STEP 3: ESP
    ---------------------------------------------------------------------
    local espConnected = false
    local espConn = nil

    local function highlightModel(model)
        pcall(function()
            if model:IsA("Model")
                and model:FindFirstChildOfClass("Humanoid")
                and not model:FindFirstChild("BC_Highlight") then
                local h = Instance.new("Highlight")
                h.Name = "BC_Highlight"
                h.FillColor = Color3.fromRGB(255, 60, 60)
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.FillTransparency = 0.5
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = model
            end
        end)
    end

    local function clearHighlights()
        pcall(function()
            local enemies = workspace:FindFirstChild("Enemies")
            if not enemies then return end
            for _, m in ipairs(enemies:GetChildren()) do
                local h = m:FindFirstChild("BC_Highlight")
                if h then h:Destroy() end
            end
        end)
    end

    local function enableESP()
        if espConnected then return end
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies then return end
        espConnected = true
        for _, m in ipairs(enemies:GetChildren()) do highlightModel(m) end
        espConn = enemies.ChildAdded:Connect(function(m)
            task.wait(0.2)
            if Config.ESP then highlightModel(m) end
        end)
        table.insert(Connections, espConn)
    end

    local function disableESP()
        if not espConnected then return end
        espConnected = false
        if espConn then
            pcall(function() espConn:Disconnect() end)
            espConn = nil
        end
        clearHighlights()
    end

    task.spawn(function()
        while Running and task.wait(0.5) do
            if Config.ESP then
                pcall(enableESP)
                pcall(function()
                    local enemies = workspace:FindFirstChild("Enemies")
                    if enemies then
                        for _, m in ipairs(enemies:GetChildren()) do highlightModel(m) end
                    end
                end)
            else
                pcall(disableESP)
            end
        end
    end)

    ---------------------------------------------------------------------
    -- Shared SELL logic
    ---------------------------------------------------------------------
    local function sellFish()
        -- FALLBACK: remote names are guesses; pcall keeps this safe
        local remote = findRemote({ "SellAllFish", "SellFish", "FishSell" })
        if remote then
            fire(remote)
            return true
        end
        local ok = pcall(function()
            local npc = findNPC({ "Fish Merchant", "Merchant", "Fish Seller" })
            if npc then
                local part = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    tweenTo(part.CFrame * CFrame.new(0, 0, 4), 1)
                    task.wait(1)
                    local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then activatePrompt(prompt) end
                end
            end
        end)
        return ok
    end

    ---------------------------------------------------------------------
    -- STEP 4: Auto Fishing state machine
    ---------------------------------------------------------------------
    local currentState = "IDLE"
    local catchCount = 0
    local biteGui = nil

    local cachedFishingGui = nil
    local lastGuiScan = 0
    local guiCacheConns = {}
    local cachedFishingPrompt = nil

    local function stopFishing(reason)
        Config.AutoFishing = false
        currentState = "IDLE"
        if reason then notify(reason, false) end
        pcall(function()
            if UI.SetToggle then UI.SetToggle("Auto Fishing", false) end
        end)
    end

    local function equipRod()
        local rod = findTool(Config.SelectedRod)
        if not rod then return nil end
        local hum = getHum()
        if hum and rod.Parent ~= LocalPlayer.Character then
            pcall(function() hum:EquipTool(rod) end)
            task.wait(0.2)
        end
        return rod
    end

    local States = {}

    States.IDLE = function()
        if not Config.AutoFishing then return end
        currentState = "EQUIP_ROD"
    end

    States.EQUIP_ROD = function()
        if not Config.AutoFishing then return end
        if not Config.SelectedRod then
            stopFishing("Select a rod first")
            return
        end
        if not findTool(Config.SelectedRod) then
            stopFishing("Rod not in backpack")
            return
        end
        equipRod()
        currentState = "BUY_BAIT"
    end

    States.BUY_BAIT = function()
        if not Config.AutoFishing then return end
        if not Config.AutoBuyBait or not Config.SelectedBait then
            currentState = "CAST"
            return
        end
        if findTool(Config.SelectedBait) then
            currentState = "CAST"
            return
        end
        -- FALLBACK: shop remote name uncertain
        local shop = findRemote({ "BuyItem", "Purchase", "Shop", "BuyBait" })
        if shop then
            fire(shop, "Bait", Config.SelectedBait, 1)
        end
        task.wait(0.5)
        if not findTool(Config.SelectedBait) then
            notify("Bait purchase failed", false)
        end
        currentState = "CAST"
    end

    States.CAST = function()
        if not Config.AutoFishing then return end
        if not isAlive() then
            task.wait(1)
            return
        end
        if not equipRod() then
            stopFishing("Rod not in backpack")
            return
        end

        local done = false
        pcall(function()
            if cachedFishingPrompt and cachedFishingPrompt.Parent then
                activatePrompt(cachedFishingPrompt)
                done = true
                return
            end
            cachedFishingPrompt = nil

            local root = getRoot()
            if not root then return end
            local parts = workspace:GetPartBoundsInRadius(root.Position, 30)
            for _, part in ipairs(parts) do
                local p = part:FindFirstChildOfClass("ProximityPrompt")
                if p and p.ActionText:lower():find("fish") then
                    cachedFishingPrompt = p
                    activatePrompt(p)
                    done = true
                    break
                end
            end
        end)
        -- FALLBACK: remote route
        if not done then
            local rem = findRemote({ "FishingEvent", "Fishing", "FishEvent" })
            if rem then done = fire(rem, "Cast") end
        end
        -- FALLBACK: tool activation
        if not done then
            pcall(function()
                local rod = findTool(Config.SelectedRod)
                if rod and rod.Parent == LocalPlayer.Character then rod:Activate() end
            end)
        end

        task.wait(math.random(20, 40) / 10)
        currentState = "WAIT_BITE"
    end

    local function guiVisible(g)
        if g:IsA("ScreenGui") then return g.Enabled end
        local ok, v = pcall(function() return g.Visible end)
        if ok and v ~= nil then return v end
        return true
    end

    local function cacheFishingGui(inst)
        cachedFishingGui = inst
        for _, c in ipairs(guiCacheConns) do pcall(function() c:Disconnect() end) end
        guiCacheConns = {}
        local function clear()
            if cachedFishingGui == inst then
                cachedFishingGui = nil
                lastGuiScan = 0
            end
        end
        table.insert(guiCacheConns, inst.Destroying:Connect(clear))
        table.insert(guiCacheConns, inst.AncestryChanged:Connect(function(_, parent)
            if parent == nil then clear() end
        end))
    end

    local function detectBite()
        if cachedFishingGui then
            if cachedFishingGui.Parent then
                if guiVisible(cachedFishingGui) then
                    return cachedFishingGui
                end
                return nil
            end
            cachedFishingGui = nil
            lastGuiScan = 0
        end

        if os.clock() - lastGuiScan < 1 then return nil end
        lastGuiScan = os.clock()

        local candidate = nil
        pcall(function()
            candidate = scanPlayerGui(function(d)
                return d.Name == "FishingGui" or (d:IsA("TextLabel") and d.Text == "!")
            end)
        end)

        if candidate then
            cacheFishingGui(candidate)
            if guiVisible(candidate) then return candidate end
        end
        return nil
    end

    States.WAIT_BITE = function()
        local start = os.clock()
        biteGui = nil
        while os.clock() - start < 30 do
            if not Config.AutoFishing or not Running then
                currentState = "IDLE"
                return
            end
            local g = detectBite()
            if g then
                biteGui = g
                currentState = "CATCH"
                return
            end
            task.wait(0.25)
        end
        currentState = "CAST"
    end

    States.CATCH = function()
        if not Config.AutoFishing then return end
        local caught = false
        pcall(function()
            local target = biteGui
            if target and target.Parent then
                local btn = nil
                if target:IsA("GuiButton") then
                    btn = target
                else
                    btn = target:FindFirstChildWhichIsA("TextButton", true)
                        or target:FindFirstChildWhichIsA("ImageButton", true)
                end
                if btn then
                    activateButton(btn)
                    caught = true
                end
            end
        end)
        if not caught then
            local rem = findRemote({ "FishingEvent", "Fishing", "FishEvent" })
            if rem then caught = fire(rem, "Catch") end
        end
        task.wait(math.random(10, 20) / 10)
        catchCount += 1
        biteGui = nil
        if catchCount >= 20 and Config.AutoSellFish then
            currentState = "SELL"
        else
            currentState = "CAST"
        end
    end

    States.SELL = function()
        if not Config.AutoFishing then return end
        sellFish()
        task.wait(1)
        catchCount = 0
        currentState = Config.AutoFishing and "CAST" or "IDLE"
    end

    task.spawn(function()
        while Running and task.wait(0.1) do
            if not Config.AutoFishing then
                currentState = "IDLE"
                -- preserve counter across toggles
            else
                local fn = States[currentState]
                if fn then
                    local ok, err = pcall(fn)
                    if not ok then
                        warn("[Core] Fishing state error: " .. tostring(err))
                        task.wait(1)
                    end
                else
                    currentState = "IDLE"
                end
            end
        end
    end)

    ---------------------------------------------------------------------
    -- STEP 5: Auto Fishing Quest
    ---------------------------------------------------------------------
    task.spawn(function()
        while Running and task.wait(1) do
            if Config.AutoFishingQuest then
                pcall(function()
                    local remote = findRemote({ "QuestEvent", "Quest", "CommF_" })
                    local complete = false
                    local active = false

                    scanPlayerGui(function(d)
                        if d:IsA("TextLabel") and d.Visible then
                            local txt = d.Text:lower()
                            if txt:find("fish") and txt:find("quest") then
                                active = true
                            end
                            if active and txt:find("complete") then
                                complete = true
                                return true
                            end
                        end
                        return false
                    end)

                    if complete then
                        if remote then
                            -- FALLBACK: remote args uncertain
                            fire(remote, "TurnIn")
                        else
                            local npc = findNPC({ "Fish Quest Giver", "Fishing Quest NPC" })
                            if npc then
                                local part = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart", true)
                                if part then
                                    tweenTo(part.CFrame * CFrame.new(0, 0, 4), 1)
                                    task.wait(1)
                                    local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt then activatePrompt(prompt) end
                                end
                            end
                        end
                    elseif not active then
                        if remote then fire(remote, "Accept") end
                    end
                end)
            end
        end
    end)

    ---------------------------------------------------------------------
    -- STEP 6: Standalone Auto Sell
    ---------------------------------------------------------------------
    task.spawn(function()
        local last = 0
        while Running and task.wait(1) do
            if Config.AutoSellFish and not Config.AutoFishing then
                if os.clock() - last >= 30 then
                    last = os.clock()
                    pcall(sellFish)
                end
            end
        end
    end)

    ---------------------------------------------------------------------
    -- STEP 7: Auto Farm Level
    ---------------------------------------------------------------------
    local function getLevel()
        local ok, lvl = pcall(function()
            return LocalPlayer:WaitForChild("Data", 5)
                :WaitForChild("Level", 5).Value
        end)
        return ok and lvl or 1
    end

    local function enemyLevel(model)
        local lv = nil
        pcall(function()
            local tag = model:FindFirstChild("Level")
            if tag and tag:IsA("ValueBase") then
                lv = tag.Value
                return
            end
            local n = model.Name:match("[Ll]v%.?%s*(%d+)")
            if n then lv = tonumber(n) end
        end)
        return lv
    end

    local function nearestEnemy(playerLevel)
        local root = getRoot()
        if not root then return nil end
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies then return nil end
        local best, bestDist = nil, math.huge
        for _, m in ipairs(enemies:GetChildren()) do
            pcall(function()
                local hum = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local lv = enemyLevel(m)
                    if lv == nil or lv <= playerLevel + 5 then
                        local d = (hrp.Position - root.Position).Magnitude
                        if d < bestDist then
                            best, bestDist = m, d
                        end
                    end
                end
            end)
        end
        return best
    end

    local function attack()
        pcall(function()
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end)
        clickAt(screenCenter())
    end

    task.spawn(function()
        while Running and task.wait(0.1) do
            if Config.AutoFarmLevel then
                if not isAlive() then
                    task.wait(1)
                else
                    local target = nearestEnemy(getLevel())
                    if target then
                        local hrp = target:FindFirstChild("HumanoidRootPart")
                        local hum = target:FindFirstChildOfClass("Humanoid")
                        if hrp and hum then
                            while Running and Config.AutoFarmLevel and isAlive()
                                and hum.Health > 0 and hrp.Parent do
                                tweenTo(hrp.CFrame * CFrame.new(0, 0, 3), 0.15)
                                attack()
                                task.wait(0.1)
                            end
                        end
                    else
                        pcall(function()
                            local sp = findSpawn()
                            if sp then
                                tweenTo(sp.CFrame * CFrame.new(0, 4, 0), 0.5)
                            end
                        end)
                        task.wait(2)
                    end
                end
            end
        end
    end)

    ---------------------------------------------------------------------
    -- STEP 8: Cleanup
    ---------------------------------------------------------------------
    _G.BananaCatCore = {
        StopAll = function()
            Running = false
            for k in pairs(Config) do
                if type(Config[k]) == "boolean" then Config[k] = false end
            end
            -- keep the UI toggles in sync with the cleared flags
            pcall(function()
                for _, st in pairs(UI.ToggleStates or {}) do
                    pcall(st.Set, false)
                end
            end)
            for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
            for _, c in ipairs(guiCacheConns) do pcall(function() c:Disconnect() end) end
            clearHighlights()
            local hum = getHum()
            if hum then pcall(function() hum.WalkSpeed = OriginalWalkSpeed end) end
            print("[BananaCat Core] Stopped.")
        end,
    }

    print("[BananaCat Hub] Loaded successfully")
end
