        }, PagesHolder)
        new("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }, sf)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 4),
        }, sf)
        Pages[name] = sf
        return sf
    end

    local FishingPage = makePage("Fishing")
    local MiscPage = makePage("Misc")

    local function selectTab(name)
        closeAll()
        for n, b in pairs(TabButtons) do
            local active = (n == name)
            b.TextColor3 = active and WHITE or Color3.fromRGB(150, 150, 150)
            Pages[n].Visible = active
        end
        local b = TabButtons[name]
        if b then
            TweenService:Create(Underline, TweenInfo.new(0.15), {
                Position = UDim2.fromOffset(b.Position.X.Offset, 27),
            }):Play()
        end
    end

    local function makeTab(name, x)
        local b = new("TextButton", {
            Name = name .. "Tab",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(90, 27),
