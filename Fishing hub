            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextColor3 = Color3.fromRGB(150, 150, 150),
            Text = name,
        }, TabBar)
        TabButtons[name] = b
        track(b.MouseButton1Click:Connect(function() selectTab(name) end))
    end
    makeTab("Fishing", 10)
    makeTab("Misc", 100)

    ---------------------------------------------------------------------
    -- Toggle component
    ---------------------------------------------------------------------
    local ToggleStates = {}

    local function createToggle(page, name, configKey, order, onChange)
        local row = new("TextButton", {
            Name = name,
            AutoButtonColor = false,
            Text = "",
            BackgroundColor3 = ROW_BG,
            BackgroundTransparency = 0.4,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(440, 34),
            LayoutOrder = order,
        }, page)
        corner(row, 6)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(1, -70, 1, 0),
            Font = Enum.Font.Gotham,
            TextSize = 14,
            TextColor3 = WHITE,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name,
        }, row)

        local pill = new("Frame", {
            BackgroundColor3 = GRAY,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(36, 18),
            Position = UDim2.new(1, -46, 0.5, -9),
        }, row)
        corner(pill, 9)
        local knob = new("Frame", {
            BackgroundColor3 = WHITE,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(14, 14),
            Position = UDim2.fromOffset(2, 2),
        }, pill)
        corner(knob, 7)

        local state = false
        local function render()
            local info = TweenInfo.new(0.12)
            TweenService:Create(pill, info, {
                BackgroundColor3 = state and GREEN or GRAY,
            }):Play()
            TweenService:Create(knob, info, {
                Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
            }):Play()
        end

        local function Set(v)
            state = v and true or false
            Config[configKey] = state
            render()
            if onChange then pcall(onChange, state) end
        end

        track(row.MouseButton1Click:Connect(function()
            Set(not state)
            Notify(name .. (state and " ON" or " OFF"), state)
        end))
        track(row.MouseEnter:Connect(function() row.BackgroundColor3 = ROW_HOVER end))
        track(row.MouseLeave:Connect(function() row.BackgroundColor3 = ROW_BG end))

        ToggleStates[name] = {
            Set = Set,
            Get = function() return state end,
            Button = row,
        }
    end

    ---------------------------------------------------------------------
    -- Dropdown component (list lives under ScreenGui, never clipped)
    ---------------------------------------------------------------------
    local function createDropdown(page, name, configKey, order)
        local button = new("TextButton", {
            Name = name,
            AutoButtonColor = false,
            Text = "",
            BackgroundColor3 = ROW_BG,
            BackgroundTransparency = 0.4,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(440, 34),
            LayoutOrder = order,
        }, page)
        corner(button, 6)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.fromOffset(120, 34),
            Font = Enum.Font.Gotham,
            TextSize = 14,
            TextColor3 = WHITE,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name,
        }, button)

        local valueLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(136, 0),
            Size = UDim2.new(1, -170, 1, 0),
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextColor3 = Color3.fromRGB(180, 180, 180),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = "None",
        }, button)

        local arrow = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -26, 0, 0),
            Size = UDim2.fromOffset(20, 34),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = WHITE,
            Text = "▼",
        }, button)

        local list = new("Frame", {
            Name = name .. "_List",
            BackgroundColor3 = Color3.fromRGB(35, 35, 35),
            BackgroundTransparency = 0.05,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(440, 150),
            Visible = false,
            Active = true,
            ZIndex = 51,
        }, Gui)
        corner(list, 6)
        stroke(list, Color3.fromRGB(90, 90, 90), 0.3, 1)

        local scroll = new("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, list)
        new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

        local isOpen = false
        local callback = nil

        local function Close()
            if not isOpen then return end
            isOpen = false
            list.Visible = false
            TweenService:Create(arrow, TweenInfo.new(0.12), { Rotation = 0 }):Play()
        end

        local function Open()
            closeAll()
            local pos = button.AbsolutePosition
            local size = button.AbsoluteSize
            local y = pos.Y + size.Y + 4
            if y + 150 > Gui.AbsoluteSize.Y then
                y = math.max(0, pos.Y - 150 - 4) -- flip above if it would run off-screen
            end
            list.Position = UDim2.fromOffset(pos.X, y)
            list.Size = UDim2.fromOffset(size.X, 150)
            list.Visible = true
            ClickCatcher.Visible = true
            isOpen = true
            TweenService:Create(arrow, TweenInfo.new(0.12), { Rotation = 180 }):Play()
        end

        local function select(item)
            Config[configKey] = item
            valueLabel.Text = tostring(item)
            if callback then pcall(callback, item) end
            closeAll()
        end

        local function SetItems(items, cb)
            callback = cb
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            for i, item in ipairs(items or {}) do
                local it = new("TextButton", {
                    AutoButtonColor = false,
                    BackgroundColor3 = BLUE,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 30),
                    LayoutOrder = i,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = WHITE,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = "  " .. tostring(item),
                }, scroll)
                it.MouseEnter:Connect(function() it.BackgroundTransparency = 0.2 end)
                it.MouseLeave:Connect(function() it.BackgroundTransparency = 1 end)
                it.MouseButton1Click:Connect(function() select(item) end)
            end
        end

        track(button.MouseButton1Click:Connect(function()
            if isOpen then closeAll() else Open() end
        end))
        track(button.MouseEnter:Connect(function() button.BackgroundColor3 = ROW_HOVER end))
        track(button.MouseLeave:Connect(function() button.BackgroundColor3 = ROW_BG end))

        Dropdowns[name] = {
            SetItems = SetItems,
            Frame = list,
            Button = button,
            Close = Close,
        }
    end

