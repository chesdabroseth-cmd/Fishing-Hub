-- PART 1: UI
do
    if _G.BananaCatUI and type(_G.BananaCatUI.Destroy) == "function" then
        pcall(_G.BananaCatUI.Destroy)
    end

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    local oldGui = PlayerGui:FindFirstChild("BananaCatHub")
    if oldGui then oldGui:Destroy() end

    local Config = {
        AutoFishing = false,
        AutoFishingQuest = false,
        AutoSellFish = false,
        AutoBuyBait = false,
        SelectedRod = nil,
        SelectedBait = nil,
        SpeedBoost = false,
        SpeedValue = 50,
        AutoFarmLevel = false,
        ESP = false,
    }

    local Connections = {}
    local function track(c)
        table.insert(Connections, c)
        return c
    end

    local WHITE = Color3.fromRGB(255, 255, 255)
    local BLUE = Color3.fromRGB(30, 130, 255)
    local GREEN = Color3.fromRGB(50, 200, 100)
    local RED = Color3.fromRGB(200, 50, 50)
    local GRAY = Color3.fromRGB(100, 100, 100)
    local ROW_BG = Color3.fromRGB(55, 55, 55)
    local ROW_HOVER = Color3.fromRGB(70, 70, 70)

    local function new(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do o[k] = v end
        if parent then o.Parent = parent end
        return o
    end
    local function corner(obj, r)
        return new("UICorner", { CornerRadius = UDim.new(0, r) }, obj)
    end
    local function stroke(obj, color, transp, thick)
        return new("UIStroke", {
            Color = color, Transparency = transp, Thickness = thick,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, obj)
    end
    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end
    local function isMove(input)
        return input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
    end

    ---------------------------------------------------------------------
    -- ScreenGui / Main / Shadow
    ---------------------------------------------------------------------
