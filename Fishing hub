        "Basic Rod", "Bamboo Rod", "Triple Rod", "Steel Rod",
        "Magnetic Rod", "Destroyer Rod", "Cursed Rod", "Rabbit Rod",
        "Rod of the Deep", "Serpent Rod",
    }
    local BAITS = {
        "Basic Bait", "Good Bait", "Great Bait", "Super Bait",
        "Mysterious Bait", "Corrupted Bait",
    }

    pcall(SetDropdownItems, "Select Rod", RODS, function(item)
        Config.SelectedRod = item
    end)
    pcall(SetDropdownItems, "Select Bait", BAITS, function(item)
